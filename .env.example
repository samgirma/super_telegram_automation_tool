# Get api_id / api_hash from https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=

# Phone number in international format, digits and + only
TG_PHONE=+10000000000

# Seconds to wait between invite attempts. Keep this at or above 5.
TG_ADD_DELAY=5

# Seconds to wait between participant PAGES, not between members. Each page is
# up to 200 members, so 0.2 already means several thousand members a minute.
# Raise it if you hit flood waits; lower it to 0 only if you are in a hurry.
TG_SCRAPE_DELAY=0.2

# Telethon waits this long on a FloodWait before retrying. Set to 0 to handle
# flood waits manually so they get logged instead of silently slept through.
TG_FLOOD_SLEEP_THRESHOLD=0
